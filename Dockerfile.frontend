# Dockerfile.frontend
# Multi-stage build:
# Stage 1 (builder): Node.js builds the React app into static files
# Stage 2 (server):  nginx serves the static files
#
# The final image is ~25MB (nginx:alpine) instead of ~900MB (node)

# ── Stage 1: Build ─────────────────────────────────────────────────────────
FROM node:20-slim AS builder

WORKDIR /app

COPY frontend/package*.json .
RUN npm install

COPY frontend/ .

# VITE_API_URL is embedded at build time into the JavaScript bundle.
# It cannot be changed at runtime — this is how Vite env vars work.
# The docker-compose.yml passes the correct value as a build argument.
ARG VITE_API_URL=http://localhost:8000
ENV VITE_API_URL=$VITE_API_URL

RUN npm run build
# Output is in /app/dist


# ── Stage 2: Serve ─────────────────────────────────────────────────────────
FROM nginx:alpine

# Copy built React app from Stage 1
COPY --from=builder /app/dist /usr/share/nginx/html

# Replace default nginx config with our SPA config
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80